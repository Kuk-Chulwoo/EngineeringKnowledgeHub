# Defaults resolve relative to project root; shell environment variables override them.
EKH_DATABASE_PATH=data/hub.sqlite3
EKH_STORAGE_ROOT=data/datasheets
EKH_MAX_UPLOAD_MB=50
# .env is not loaded automatically. Set these in PowerShell before starting.

# Generated with scripts/setup-reviewer.ps1; keep this credentials file out of Git.
EKH_REVIEWER_FILE=data/reviewer.json

# Phase 2B: configure identically in backend and worker shells. Disabled by default.
EKH_EXTERNAL_AI_ENABLED=false
# Choose a model available to your account that supports strict Structured Outputs.
EKH_OPENAI_MODEL=
OPENAI_API_KEY=
# Comma-separated revision IDs forbidden from external transmission (optional).
EKH_AI_DENIED_REVISIONS=
